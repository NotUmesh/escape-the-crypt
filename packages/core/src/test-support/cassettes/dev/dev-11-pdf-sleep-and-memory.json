            {
              "label": "sleep aids learning through memory consolidation",
              "chunkIds": [
                "chk_086e3ef6bbaa_1"
              ],
              "quotes": [
                "Sleep is a well-known aid to learning",
                "the brain replays recent experiences",
                "This replay is thought to help move new information into long-term storage",
                "The process is called memory consolidation"
              ]
            },
            {
              "label": "sleep stages occur in a fixed order",
              "chunkIds": [
                "chk_086e3ef6bbaa_3",
                "chk_086e3ef6bbaa_4"
              ],
              "quotes": [
                "A night of sleep moves through four stages in a fixed order",
                "1. Light sleep, when the body begins to relax.",
                "2. Deeper sleep, when heart rate and breathing slow down.",
                "3. Slow-wave sleep, the deepest stage, when the brain is hardest to wake.",
                "4. REM sleep, when most vivid dreams occur."
              ]
            },
            {
              "label": "sleep affects recall of studied material",
              "chunkIds": [
                "chk_086e3ef6bbaa_6",
                "chk_086e3ef6bbaa_7"
              ],
              "quotes": [
                "volunteers who slept for eight hours recalled more word pairs",
                "than volunteers who stayed awake",
                "The effect is strongest for facts that were studied just before bed"
              ]
            },
            {
              "label": "recommended sleep duration by age",
              "chunkIds": [
                "chk_086e3ef6bbaa_7"
              ],
              "quotes": [
                "Adults need about seven to nine hours of sleep",
                "teenagers need about eight to ten hours"
              ]
            }
          ]
        },
