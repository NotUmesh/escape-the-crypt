# Names read by apps/worker/src/config.ts. Set them in the worker's environment; the worker loads no .env file.
# Never commit values.

# Provider: openai (default when unset) or gemini. Switching is manual; there is no automatic failover.
PROVIDER=

# Required
WEB_ORIGIN=

# Required when PROVIDER is openai or unset
OPENAI_API_KEY=
OPENAI_MODEL=

# Required when PROVIDER=gemini (a missing or invalid value stops the worker at startup)
# GEMINI_MODEL is a bare model ID such as gemini-3.8-flash; there is no default in code.
# Use a key from a billing-enabled project: on unpaid quota Google may have humans review inputs.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PRICE_INPUT_USD_PER_MTOK=
GEMINI_PRICE_OUTPUT_USD_PER_MTOK=

# Required for the worker to accept jobs (without them every job is refused)
DAILY_BUDGET_USD=
# OpenAI prices; ignored when PROVIDER=gemini
PRICE_INPUT_USD_PER_MTOK=
PRICE_OUTPUT_USD_PER_MTOK=

# Optional
PORT=
JOB_TTL_MINUTES=
# Judge access for POST /judge/jobs: at least 24 characters, random. Set it in Render only.
# Unset or shorter: the judge route answers 404. Judge jobs still spend from DAILY_BUDGET_USD.
JUDGE_ACCESS_TOKEN=
# DISABLED_LOCK_TYPES= comma-separated Lock_Types the learner path will not ask for; unset disables nothing