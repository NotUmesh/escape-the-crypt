{
  "name": "escape-the-crypt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @escape-the-crypt/web dev",
    "test": "pnpm -r test --run && vitest run --project scripts",
    "lint": "eslint . && node scripts/check-structure.ts",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "e2e": "pnpm --filter @escape-the-crypt/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "4.1.12"
  }
}
